{
  "manifest_version": 3,
  "name": "Ocean of Jobs Auto Apply",
  "version": "1.9.13",
  "description": "Applies to jobs for you on Workday, Greenhouse, Lever, and 11 other hiring sites, and fills in other application forms.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "https://oceanofjobs.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.lever.co/*",
    "https://*.smartrecruiters.com/*",
    "https://*.recruitee.com/*",
    "https://*.jobs.personio.de/*",
    "https://*.jobs.personio.com/*",
    "https://*.teamtailor.com/*",
    "https://*.breezy.hr/*",
    "https://*.comeet.com/*",
    "https://*.comeet.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.oraclecloud.com/*",
    "https://jobs.deel.com/*",
    "https://*.applytojob.com/*",
    "https://*.pinpointhq.com/*",
    "https://*.bamboohr.com/*",
    "https://jobs.jobvite.com/*",
    "https://*.careers.hibob.com/*",
    "https://jobs.gem.com/*",
    "https://*.eightfold.ai/*",
    "https://*.hunterhrms.com/*",
    "https://www.amazon.jobs/*",
    "https://apply.careers.microsoft.com/*",
    "https://jobs.apple.com/*",
    "https://careers.checkpoint.com/*",
    "https://www.ness-tech.co.il/*",
    "https://experis.co.il/*",
    "https://www.matrix.co.il/*",
    "https://www.nogamy.co.il/*",
    "https://yaelgroup.com/*",
    "https://jobs.clalitapps.co.il/*",
    "https://jobs.iai.co.il/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "externally_connectable": { "matches": ["https://oceanofjobs.com/*"] },
  "content_scripts": [
    {
      "matches": [
        "https://oceanofjobs.com/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.lever.co/*",
        "https://*.smartrecruiters.com/*",
        "https://*.recruitee.com/*",
        "https://*.jobs.personio.de/*",
        "https://*.jobs.personio.com/*",
        "https://*.teamtailor.com/*",
        "https://*.breezy.hr/*",
        "https://*.comeet.com/*",
        "https://*.comeet.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.oraclecloud.com/*",
        "https://jobs.deel.com/*",
        "https://*.applytojob.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.bamboohr.com/*",
        "https://jobs.jobvite.com/*",
        "https://*.careers.hibob.com/*",
        "https://jobs.gem.com/*",
        "https://*.eightfold.ai/*",
        "https://*.hunterhrms.com/*",
        "https://www.amazon.jobs/*",
        "https://apply.careers.microsoft.com/*",
        "https://jobs.apple.com/*",
        "https://careers.checkpoint.com/*",
        "https://www.ness-tech.co.il/*",
        "https://experis.co.il/*",
        "https://www.matrix.co.il/*",
        "https://www.nogamy.co.il/*",
        "https://yaelgroup.com/*",
        "https://jobs.clalitapps.co.il/*",
        "https://jobs.iai.co.il/*"
      ],
      "js": [
        "lib/match.js",
        "ats/greenhouse.js",
        "ats/ashby.js",
        "ats/workable.js",
        "ats/generic.js",
        "detect.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
