<mxfile host="app.diagrams.net"><diagram name="Job board" id="Job board"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Job board-1" value="Job board: from company hiring systems to the board" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="30" as="geometry"/></mxCell><mxCell id="Job board-2" value="Scrapers poll public job APIs, the box loads their fragments into SQLite, and the board reads it through Cloudflare and CloudFront." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="Job board-3" value="&lt;b&gt;Company hiring systems&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Comeet, Workday and more: their public job APIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="190" height="90" as="geometry"/></mxCell><mxCell id="Job board-4" value="GitHub Actions" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fffcf0;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="230" height="250" as="geometry"/></mxCell><mxCell id="Job board-5" value="&lt;b&gt;Discovery, daily&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;scrape-discover, discover-companies: guesses ATS tokens, reads Comeet embeds, refreshes Workday tenants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="125" width="200" height="95" as="geometry"/></mxCell><mxCell id="Job board-6" value="&lt;b&gt;Enrichment&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;resolve-company-names, resolve-company-logos, build-salary-matrix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="240" width="200" height="75" as="geometry"/></mxCell><mxCell id="Job board-7" value="AWS Lambda" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#faf5fc;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="380" width="230" height="140" as="geometry"/></mxCell><mxCell id="Job board-8" value="&lt;b&gt;Fast scrape&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;iljobs-scrape-fast on EventBridge, every 5 min: re-polls known company and ATS pairs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="415" width="200" height="90" as="geometry"/></mxCell><mxCell id="Job board-9" value="S3 and DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f3f8fe;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="230" height="600" as="geometry"/></mxCell><mxCell id="Job board-10" value="&lt;b&gt;Delta fragments&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;JSON, each company's whole board per poll&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="125" width="200" height="60" as="geometry"/></mxCell><mxCell id="Job board-11" value="&lt;b&gt;Description blobs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one object per description; the API fetches it when a listing is opened&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="205" width="200" height="70" as="geometry"/></mxCell><mxCell id="Job board-12" value="&lt;b&gt;Published artifacts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;facets, stats, bootstrap, explore, sitemap, company names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="295" width="200" height="65" as="geometry"/></mxCell><mxCell id="Job board-13" value="&lt;b&gt;Lean daily snapshot&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;read by the fallback Lambda API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="380" width="200" height="55" as="geometry"/></mxCell><mxCell id="Job board-14" value="&lt;b&gt;Litestream replicas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;jobs.db and jobs-fts.db, continuous&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="455" width="200" height="55" as="geometry"/></mxCell><mxCell id="Job board-15" value="&lt;b&gt;Static site&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;board, account and Auto apply pages, /docs; CloudFront serves it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="530" width="200" height="65" as="geometry"/></mxCell><mxCell id="Job board-16" value="&lt;b&gt;DynamoDB iljobs-alerts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;alerts, saved jobs, profiles, tokens&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="615" width="200" height="60" as="geometry"/></mxCell><mxCell id="Job board-17" value="The box: EC2 t4g.small, il-central-1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f4faf2;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="420" height="600" as="geometry"/></mxCell><mxCell id="Job board-18" value="&lt;b&gt;fetch_fragments&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;every 30 s, copies new fragments to a local spool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="125" width="180" height="60" as="geometry"/></mxCell><mxCell id="Job board-19" value="&lt;b&gt;Watchdog&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;restarts stopped otj-* timers every 15 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="125" width="180" height="60" as="geometry"/></mxCell><mxCell id="Job board-20" value="&lt;b&gt;Applier (shadow_apply)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;loads fragments, one heavy job at a time (flock)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="205" width="180" height="60" as="geometry"/></mxCell><mxCell id="Job board-21" value="&lt;b&gt;jobs.db&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;SQLite, WAL, listings and companies&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="Job board-22" value="&lt;b&gt;jobs-fts.db&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;full-text search index, attached as fts&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="Job board-23" value="&lt;b&gt;Publisher (timer)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;precompute, bootstrap, explore.db, sitemap, daily lean snapshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="385" width="180" height="75" as="geometry"/></mxCell><mxCell id="Job board-24" value="&lt;b&gt;gunicorn: api/handler.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;2 workers x 4 threads on :8000. /api/*, /job/*, /company/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="385" width="180" height="75" as="geometry"/></mxCell><mxCell id="Job board-25" value="&lt;b&gt;Litestream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;streams both databases to S3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="485" width="180" height="55" as="geometry"/></mxCell><mxCell id="Job board-26" value="&lt;b&gt;Alerts, every 10 min&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;matches new listings to the saved alerts in DynamoDB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="485" width="180" height="55" as="geometry"/></mxCell><mxCell id="Job board-27" value="&lt;b&gt;cloudflared tunnel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;box.oceanofjobs.com, the only way in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="590" width="380" height="50" as="geometry"/></mxCell><mxCell id="Job board-28" value="Edge" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fff8f0;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="1310" y="90" width="240" height="600" as="geometry"/></mxCell><mxCell id="Job board-29" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;DNS, WAF rate limit. Worker otj-box-router on /api/*, fast path, fails open&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1325" y="125" width="210" height="80" as="geometry"/></mxCell><mxCell id="Job board-30" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;static site from S3. /job/*, /company/*, /api/* to the tunnel. /api/auth/* to Lambda&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1325" y="230" width="210" height="90" as="geometry"/></mxCell><mxCell id="Job board-31" value="&lt;b&gt;Sign-in Lambda + Cognito&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;API Gateway, /api/auth/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1325" y="345" width="210" height="60" as="geometry"/></mxCell><mxCell id="Job board-32" value="&lt;b&gt;SES&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;alerts@oceanofjobs.com digests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1325" y="485" width="210" height="55" as="geometry"/></mxCell><mxCell id="Job board-33" value="&lt;b&gt;Fallback Lambda API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reads the lean snapshot if the box is pulled from rotation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1325" y="590" width="210" height="70" as="geometry"/></mxCell><mxCell id="Job board-34" value="&lt;b&gt;Job seekers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the board, company pages, alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="160" width="150" height="70" as="geometry"/></mxCell><mxCell id="Job board-35" value="&lt;b&gt;Crawlers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;walk the sitemap's job and company pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="280" width="150" height="70" as="geometry"/></mxCell><mxCell id="Job board-36" value="&lt;b&gt;Alert subscribers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="485" width="150" height="55" as="geometry"/></mxCell><mxCell id="Job board-37" value="poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-3" target="Job board-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-38" value="probe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-3" target="Job board-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-39" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-8" target="Job board-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-40" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-5" target="Job board-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-41" value="names, logos, salaries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="Job board-6" target="Job board-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-42" value="copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-10" target="Job board-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-43" value="spool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-18" target="Job board-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-44" value="upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-20" target="Job board-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-45" value="descriptions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;e