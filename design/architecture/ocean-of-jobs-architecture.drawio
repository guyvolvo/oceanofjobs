="1" source="API-17" target="API-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="API-44" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="API-18" target="API-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="API-45" value="Legend" style="text;html=1;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="200" height="20" as="geometry"/></mxCell><mxCell id="API-46" value="People and clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="190" height="20" as="geometry"/></mxCell><mxCell id="API-47" value="Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="190" height="20" as="geometry"/></mxCell><mxCell id="API-48" value="AWS edge and serverless" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="766" width="190" height="20" as="geometry"/></mxCell><mxCell id="API-49" value="The box (EC2) and our code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="190" height="20" as="geometry"/></mxCell><mxCell id="API-50" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="190" height="20" as="geometry"/></mxCell><mxCell id="API-51" value="GitHub Actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="844" width="190" height="20" as="geometry"/></mxCell><mxCell id="API-52" value="Outside services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="190" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Extension" id="Extension"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Extension-1" value="Chrome extension: fills and sends applications in the user's own browser" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="30" as="geometry"/></mxCell><mxCell id="Extension-2" value="Ocean of Jobs Auto Apply (MV3). The account holds the profile and the queue; the browser holds the CV and secrets and does the applying." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="Extension-3" value="The user's Chrome" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fafafa;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="720" height="470" as="geometry"/></mxCell><mxCell id="Extension-4" value="&lt;b&gt;connect.js on oceanofjobs.com&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;takes the token the account page hands over&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="200" height="70" as="geometry"/></mxCell><mxCell id="Extension-5" value="&lt;b&gt;Settings page&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CV, own AI key, Workday password, fill button on all sites&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="200" height="70" as="geometry"/></mxCell><mxCell id="Extension-6" value="&lt;b&gt;/apply dashboard (React)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;settings, queue, history, AI agent; pings the extension, asks it to apply next&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="200" height="70" as="geometry"/></mxCell><mxCell id="Extension-7" value="&lt;b&gt;Popup&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;stats, Fill application, review, questions to answer, queue, pause&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="240" width="200" height="75" as="geometry"/></mxCell><mxCell id="Extension-8" value="&lt;b&gt;chrome.storage.local&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;token, CV file, own AI key, Workday password&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="240" width="200" height="75" as="geometry"/></mxCell><mxCell id="Extension-9" value="&lt;b&gt;Background service worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;runs on an alarm, picks jobs, plans each fill (match.js), ticks required boxes, settles attempts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="345" width="680" height="70" as="geometry"/></mxCell><mxCell id="Extension-10" value="&lt;b&gt;Content scripts on job pages&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;detect.js fill card; fillers for Greenhouse, Ashby, Workable and a generic one for any form; Workday injected when needed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="450" width="440" height="80" as="geometry"/></mxCell><mxCell id="Extension-11" value="&lt;b&gt;webRequest send watch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;a POST from a filled tab carrying the applicant's email, after a Submit click, marks it sent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="450" width="200" height="80" as="geometry"/></mxCell><mxCell id="Extension-12" value="&lt;b&gt;Chrome Web Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;publish-extension workflow uploads; Chrome updates users automatically&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="180" height="70" as="geometry"/></mxCell><mxCell id="Extension-13" value="&lt;b&gt;Employer hiring sites&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Greenhouse, Workday, Lever, Ashby, Comeet and others: the real application forms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="620" width="440" height="65" as="geometry"/></mxCell><mxCell id="Extension-14" value="Ocean of Jobs" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f4faf2;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="560" height="360" as="geometry"/></mxCell><mxCell id="Extension-15" value="&lt;b&gt;Box API /api/me/apply/*&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;profile, summary, history, queue, filled, attempts (reserve, settle, sent), drafts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="330" height="75" as="geometry"/></mxCell><mxCell id="Extension-16" value="&lt;b&gt;Worker otj-ai&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Workers AI drafts answers; the plan's monthly quota first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="140" width="170" height="75" as="geometry"/></mxCell><mxCell id="Extension-17" value="&lt;b&gt;DynamoDB iljobs-alerts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;#apply_profile, #plan, attempts, queue, saved answers, AI agent&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="520" height="60" as="geometry"/></mxCell><mxCell id="Extension-18" value="&lt;b&gt;Board Auto apply button&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;adds a job to the queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="165" height="75" as="geometry"/></mxCell><mxCell id="Extension-19" value="&lt;b&gt;MCP queue tools&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;an AI assistant queues jobs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1237" y="360" width="165" height="75" as="geometry"/></mxCell><mxCell id="Extension-20" value="&lt;b&gt;Paddle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;checkout and webhooks set the plan&lt;/font&gt;" style=