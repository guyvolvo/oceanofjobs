xCell id="Job board-52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-27" target="Job board-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-53" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-34" target="Job board-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-54" value="pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-34" target="Job board-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-55" value="/job, /company" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-35" target="Job board-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-56" value="fast path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-29" target="Job board-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-30" target="Job board-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-30" target="Job board-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="Job board-32" target="Job board-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Job board-60" value="Legend" style="text;html=1;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="200" height="20" as="geometry"/></mxCell><mxCell id="Job board-61" value="People and clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-62" value="Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-63" value="AWS edge and serverless" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-64" value="The box (EC2) and our code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-65" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="888" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-66" value="GitHub Actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="914" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-67" value="Outside services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="190" height="20" as="geometry"/></mxCell><mxCell id="Job board-68" value="Timers on the box take one lock, so an apply, a publish and a snapshot never walk the database at the same time. Common board views (unfiltered, tech roles, Israel) are answered from the precomputed artifacts in under 0.1 s; everything else is computed live." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="280" y="760" width="700" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="MCP" id="MCP"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MCP-1" value="MCP server: AI assistants search jobs and manage a user's account" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="30" as="geometry"/></mxCell><mxCell id="MCP-2" value="A Cloudflare Worker speaks MCP at oceanofjobs.com/mcp and calls the same box API the website uses." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="MCP-3" value="&lt;b&gt;AI assistants&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Claude, Claude Code, ChatGPT, Cursor and other MCP clients&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="80" as="geometry"/></mxCell><mxCell id="MCP-4" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;creates a personal access token on /account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="200" height="60" as="geometry"/></mxCell><mxCell id="MCP-5" value="Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fff8f0;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="360" height="520" as="geometry"/></mxCell><mxCell id="MCP-6" value="&lt;b&gt;Worker otj-mcp&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;route oceanofjobs.com/mcp, JSON-RPC over HTTPS, fails open. 16 tools. No token: search_jobs, get_job, get_company. With a token: save_job, list_saved_jobs, remove_saved_job, list_alerts, create_alert, update_alert, delete_alert, get_preferences, update_preferences, queue_for_auto_apply, list_auto_apply_queue, remove_from_auto_apply_queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="320" height="200" as="geometry"/></mxCell><mxCell id="MCP-7" value="&lt;b&gt;Analytics Engine otj_mcp&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;method, tool, outcome, client, timing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="150" height="75" as="geometry"/></mxCell><mxCell id="MCP-8" value="&lt;b&gt;cloudflared tunnel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;with the origin key header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="400" width="150" height="75" as="geometry"/></mxCell><mxCell id="MCP-9" value="&lt;b&gt;CloudFront mcp_unavailable&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;JSON-RPC 503 when the Worker is over its daily quota&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="320" height="70" as="geometry"/></mxCell><mxCell id="MCP-10" value="The box" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f4faf2;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="360" height="520" as="geometry"/></mxCell><mxCell id="MCP-11" value="&lt;b&gt;api/handler.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/jobs, /api/jobs/{id}, /api/companies (public). /api/me/saved, alerts, profile, apply queue (token)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="320" height="85" as="geometry"/></mxCell><mxCell id="MCP-12" value="&lt;b&gt;jobs.db + jobs-fts.db&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;listings and search&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="285" width="150" height="75" as="geometry"/></mxCell><mxCell id="MCP-13" value="&lt;b&gt;api/tokens.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;checks ooj_ tokens (scope mcp), limits them to their routes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="285" width="150" height="75" as="geometry"/></mxCell><mxCell id="MCP-14" value="&lt;b&gt;DynamoDB iljobs-alerts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;hashed tokens, saved jobs, alerts, preferences, queue&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="400" width="150" height="90" as="geometry"/></mxCell><mxCell id="MCP-15" value="&lt;b&gt;Chrome extension&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;picks up queued jobs and applies (see the Extension page)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="540" width="320" height="70" as="geometry"/></mxCell><mxCell id="MCP-16" value="&lt;b&gt;workers-quota&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;GitHub Actions every 30 min, reads Worker usage, fails at 70% of 100,000 requests a day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="230" height="85" as="geometry"/></mxCell><mxCell id="MCP-17" value="pastes token into config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MCP-4" target="MCP-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-18" value="oceanofjobs.com/mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="MCP-3" target="MCP-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-19" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MCP-6" target="MCP-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="MCP-6" target="MCP-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="MCP-8" target="MCP-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-22" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="MCP-11" target="MCP-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-23" value="token routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="MCP-11" target="MCP-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="MCP-13" target="MCP-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-25" value="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MCP-14" target="MCP-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-26" value="over quota" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MCP-3" target="MCP-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="MCP-27" value="Legend" style="text;html=1;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="20" as="geometry"/></mxCell><mxCell id="MCP-28" value="People and clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="190" height="20" as="geometry"/></mxCell><mxCell id="MCP-29" value="Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="190" height="20" as="geometry"/></mxCell><mxCell id="MCP-30" value="AWS edge and serverless" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="190" height="20" as="geometry"/></mxCell><mxCell id="MCP-31" value="The box (EC2) and our code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="802" width="190" height="20" as="geometry"/></mxCell><mxCell id="MCP-32" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="190" height="20" as="geometry"/></mxCell><mxCell id="MCP-33" value="GitHub Actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="854" width="190" height="20" as="geometry"/></mxCell><mxCell id="MCP-34" value="Outside services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="190" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="API" id="API"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="API-1" value="Public API: one WSGI app on the box, two routes in" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="30" as="geometry"/></mxCell><mxCell id="API-2" value="Unauthenticated job data for anyone, account routes behind a sign-in token. Docs at /docs/api and /api/openapi.json." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1500" height="24" as="geometry"/></mxCell><mxCell id="API-3" value="&lt;b&gt;Developers and scripts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;curl, alert bots, dashboards&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="60" as="geometry"/></mxCell><mxCell id="API-4" value="&lt;b&gt;The website&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;board, company pages, account, Auto apply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="190" height="60" as="geometry"/></mxCell><mxCell id="API-5" value="&lt;b&gt;MCP Worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;otj-mcp, with the origin key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="190" height="50" as="geometry"/></mxCell><mxCell id="API-6" value="&lt;b&gt;Chrome extension&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ooj_ token, scope extension&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="190" height="55" as="geometry"/></mxCell><mxCell id="API-7" value="&lt;b&gt;Paddle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;subscription webhooks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="190" height="50" as="geometry"/></mxCell><mxCell id="API-8" value="Edge" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fff8f0;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="265" height="470" as="geometry"/></mxCell><mxCell id="API-9" value="&lt;b&gt;Cloudflare Worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;otj-box-router, /api/* fast path, rate limit on the site host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="155" width="145" height="90" as="geometry"/></mxCell><mxCell id="API-10" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/* when the Worker is over budget. /api/auth/* to Lambda&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="145" height="80" as="geometry"/></mxCell><mxCell id="API-11" value="&lt;b&gt;Sign-in Lambda + Cognito&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/auth/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="145" height="60" as="geometry"/></mxCell><mxCell id="API-12" value="&lt;b&gt;cloudflared tunnel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;to box:8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="155" width="85" height="365" as="geometry"/></mxCell><mxCell id="API-13" value="The box: gunicorn api/handler.py" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f4faf2;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="520" height="520" as="geometry"/></mxCell><mxCell id="API-14" value="&lt;b&gt;Public routes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/jobs, /api/jobs/{id}, /api/facets, /api/stats, /api/companies, /api/companies/search, /api/geo, /api/health, /api/openapi.json, /api/help&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="155" width="230" height="120" as="geometry"/></mxCell><mxCell id="API-15" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;precomputed artifacts for common views; otherwise SQLite and the search index, the query parsed once into FTS match and ranking; the description from S3 when a listing opens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="155" width="230" height="120" as="geometry"/></mxCell><mxCell id="API-16" value="&lt;b&gt;Who is asking&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Cognito JWT from the website, or an ooj_ token from MCP or the extension&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="230" height="85" as="geometry"/></mxCell><mxCell id="API-17" value="&lt;b&gt;Signed-in routes /api/me/*&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;profile, dashboard, alerts, saved, tokens, apply: profile, queue, attempts, history, AI drafts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="230" height="110" as="geometry"/></mxCell><mxCell id="API-18" value="&lt;b&gt;/api/paddle/webhook&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;signed by Paddle, sets the user's plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="430" width="230" height="60" as="geometry"/></mxCell><mxCell id="API-19" value="&lt;b&gt;Guards&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;2 expensive requests per worker (429), 25 s statement deadline (503), edge cache on /job and /company&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="520" width="230" height="90" as="geometry"/></mxCell><mxCell id="API-20" value="Data" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f3f8fe;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="260" height="520" as="geometry"/></mxCell><mxCell id="API-21" value="&lt;b&gt;Precomputed artifacts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;facets.json, stats.json, bootstrap: common views in under 0.1 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="155" width="230" height="70" as="geometry"/></mxCell><mxCell id="API-22" value="&lt;b&gt;jobs.db + jobs-fts.db&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;everything else, computed live&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="250" width="230" height="75" as="geometry"/></mxCell><mxCell id="API-23" value="&lt;b&gt;S3 description blobs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;loaded when a listing is opened&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="350" width="230" height="60" as="geometry"/></mxCell><mxCell id="API-24" value="&lt;b&gt;DynamoDB iljobs-alerts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;accounts' rows: alerts, saved, profiles, plans, attempts&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="430" width="230" height="80" as="geometry"/></mxCell><mxCell id="API-25" value="&lt;b&gt;Worker otj-ai&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;oceanofjobs.com/__ai, Workers AI, drafts answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="545" width="230" height="65" as="geometry"/></mxCell><mxCell id="API-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="API-3" target="API-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="API-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="API-4" target="API-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="API-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="API-6" target="API-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="API-29" value="