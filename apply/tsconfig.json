{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // The board port is not mounted yet and does not type-check (25 errors in
  // Pane.tsx and List.tsx). It is migrated last; bring it back in then.
  "exclude": ["src/board"]
}
