{
  "name": "apply",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens": "node scripts/tokens.mjs",
    "build": "node scripts/tokens.mjs && tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:site": "npm run build && node scripts/preview.mjs",
    "check:html": "python scripts/nojs_check.py"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.15.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "echarts": "6.1.0",
    "mammoth": "1.12.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.3.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
